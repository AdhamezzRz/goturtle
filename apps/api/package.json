{
  "name": "@goturtle/api",
  "version": "1.1.0",
  "private": true,
  "description": "GoTurtle logistics ERP \u2014 REST API (NestJS + Drizzle + MySQL/MariaDB). Also serves the web portals in production.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "db:generate": "npm i --no-save --no-audit --no-fund drizzle-kit@0.31.5 && drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:seed": "node dist/db/seed.js",
    "db:studio": "npm i --no-save --no-audit --no-fund drizzle-kit@0.31.5 && drizzle-kit studio"
  },
  "dependencies": {
    "@goturtle/shared": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.15.3",
    "papaparse": "^5.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "tsc-watch": "^7.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/test/env.ts"
    ],
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "maxWorkers": 1
  }
}
