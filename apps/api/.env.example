# ---------------------------------------------------------------------------
# GoTurtle API configuration. On Hostinger set these in hPanel → Websites →
# your Node.js app → Environment variables (they apply to build and runtime).
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Public URL of the app (used in SMS tracking links, webhooks, emails)
APP_URL=https://goturtle.example.com

# MySQL / MariaDB (Hostinger: hPanel → Databases → MySQL Databases)
DATABASE_URL=mysql://u123_goturtle:STRONG_PASSWORD@localhost:3306/u123_goturtle
# Run pending migrations automatically when the app boots
DB_AUTO_MIGRATE=true

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# 32-byte key (base64) used to encrypt integration credentials at rest
ENCRYPTION_KEY=change-me-32-bytes-base64

# First boot: creates this super admin if the users table is empty
BOOTSTRAP_ADMIN_PHONE=+201000000000
BOOTSTRAP_ADMIN_EMAIL=admin@goturtle.example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# Background jobs. Hostinger has no background workers, so jobs also run on
# demand: add an hPanel cron job (every minute) calling
#   curl -fsS -X POST "$APP_URL/api/v1/system/cron?key=$CRON_SECRET"
CRON_SECRET=change-me-cron
IN_PROCESS_JOBS=true

# File uploads (POD photos, documents). Keep OUTSIDE the app folder so
# redeploys don't wipe it, e.g. /home/u123/goturtle-uploads
UPLOAD_DIR=./uploads

# Notifications — provider: console | twilio | whatsapp_cloud | smsmisr | victorylink
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_ID=
# SMSMISR_USERNAME=
# SMSMISR_PASSWORD=
# SMSMISR_SENDER=
# SMTP_URL=smtp://user:pass@smtp.hostinger.com:465

# Payments (customer pays online instead of COD) — paymob | none
PAYMENT_PROVIDER=none
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_INTEGRATION_ID=

# Maps (optional): geocoding provider — none | google | mapbox
GEOCODER=none
# GOOGLE_MAPS_API_KEY=
